    "version": "0.2.0",
    "configurations": [
        {
            // .c と .cpp のどちらでも使える。コンパイラは build active file タスクが拡張子で選ぶ
            "name": "(LLDB) Debug",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}/",
            "preLaunchTask": "build active file"
        }
    ]
}
